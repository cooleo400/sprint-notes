{
  "name": "sprint-notes",
  "productName": "Sprint Notes",
  "version": "2.0.0",
  "description": "Live-rendered markdown task notes with Today / This Week / This Month and sprint archives",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:ui": "esbuild src/app.js --bundle --format=iife --outfile=dist/app.js",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --mac",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "esbuild test/unit/*.test.js --bundle --platform=node --format=cjs --external:jsdom --outdir=.test-build --log-level=warning && node --test .test-build/",
    "test:e2e": "npm run build:ui && node test/e2e.js",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.48.0",
    "tiptap-markdown": "^0.9.0"
  },
  "build": {
    "appId": "local.sprintnotes",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "${productName}"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/app.js"
    ]
  }
}
